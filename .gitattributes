* text=auto eol=lf

# Shell scripts must stay LF to avoid hidden \r runtime failures.
*.sh text eol=lf
*.bash text eol=lf

# Common source and config files should remain LF in repo and working tree.
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf